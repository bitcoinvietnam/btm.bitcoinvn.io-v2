---
layout: base.njk
pagination:
  data: collections.btmLocationsAll
  size: 1
  alias: item
permalink: "{{ item.localePrefix }}locations/{{ item.machine.slug }}/index.html"
eleventyComputed:
  locale: "{{ item.locale }}"
  pageTitle: "{{ item.machine.name }} BTM — {{ site.name }}"
  pageDescription: "{{ i18n[item.locale].ui.location_page.cta_sub }}"
  basePath: "locations/{{ item.machine.slug }}/"
---
{% set machine = item.machine %}
{% set t = i18n[item.locale] %}
{% set localeHome = "/" + item.localePrefix %}

{# ======== Navigation ======== #}
<nav class="nav scrolled" id="nav">
  <div class="nav-container">
    <a href="{{ localeHome }}" class="nav-logo">
      <img src="{{ '/images/bitcoinvn-logo-dark.png' | url }}" alt="BitcoinVN" class="logo-img">
      <span class="logo-btm">BTM</span>
    </a>
    <div class="nav-links" id="navLinks">
      <a href="{{ localeHome }}#locations">{{ t.ui.nav.all_locations }}</a>
      <a href="{{ localeHome }}#how-it-works">{{ t.ui.nav.how_it_works }}</a>
      <a href="{{ localeHome }}#faq">{{ t.ui.nav.faq }}</a>
      <a href="/{{ item.localePrefix }}host/">{{ t.ui.host.nav_label }}</a>
    </div>
    {% include "locale-switcher.njk" %}
    <button class="nav-toggle" id="navToggle" aria-label="{{ t.ui.nav.toggle_menu }}">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="location-detail">
  {% if machine.photos and machine.photos.length %}
  <img class="location-detail__hero-bg" src="{{ machine.photos[0].src | url }}" alt="" aria-hidden="true">
  {% endif %}
  {# ======== Breadcrumb ======== #}
  <div class="container">
    <nav class="breadcrumb">
      <a href="{{ localeHome }}">{{ t.ui.location_page.breadcrumb_home }}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      <a href="{{ localeHome }}#locations">{{ t.ui.location_page.breadcrumb_locations }}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      <span>{{ machine.name }}</span>
    </nav>
  </div>

  {# ======== Hero ======== #}
  <section class="location-hero">
    <div class="container">
      <span class="location-region-badge">{{ machine.regionName }}</span>
      <h1>{{ machine.name }}</h1>
      <p class="location-hero-district">{{ machine.district }}</p>
    </div>
  </section>

  {# ======== Info Cards ======== #}
  <section class="location-info-section">
    <div class="container">
      <div class="location-info-grid">
        <div class="location-info-card" data-hours-days="{{ machine.hours.days | join(',') }}" data-hours-open="{{ machine.hours.open }}" data-hours-close="{{ machine.hours.close }}" data-hours-tz="{{ machine.hours.timezone }}">
          <div class="location-info-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>{{ t.ui.location_page.opening_hours }}</h3>
          <span class="location-hours location-hours-centered">
            <span class="location-status-dot"></span>
            <span class="location-status-text"></span>
          </span>
          <p>{{ machine.hours.display }}</p>
        </div>
        <div class="location-info-card">
          <div class="location-info-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>{{ t.ui.location_page.cryptocurrencies }}</h3>
          <p>{{ t.ui.location_page.crypto_value }}</p>
        </div>
        <div class="location-info-card">
          <div class="location-info-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3>{{ t.ui.location_page.interface_langs }}</h3>
          <p>{{ t.ui.location_page.interface_value }}</p>
        </div>
      </div>
    </div>
  </section>

  {# ======== Map ======== #}
  <section class="location-map-section">
    <div class="container">
      <div class="location-map-single" id="location-detail-map" data-lat="{{ machine.lat }}" data-lng="{{ machine.lng }}" data-name="{{ machine.name }}" data-district="{{ machine.district }}">
      </div>
    </div>
  </section>

  {# ======== About ======== #}
  <section class="location-about">
    <div class="container">
      <div class="location-about-grid">
        <div class="location-about-details">
          <h2>{{ t.ui.location_page.about }}</h2>
          <div class="location-detail-list">
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <strong>{{ t.ui.location_page.address }}</strong>
                <p>{{ machine.address }}</p>
              </div>
            </div>
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div>
                <strong>{{ t.ui.location_page.phone }}</strong>
                <p>{{ machine.phone }}</p>
              </div>
            </div>
            <div class="location-detail-item" data-hours-days="{{ machine.hours.days | join(',') }}" data-hours-open="{{ machine.hours.open }}" data-hours-close="{{ machine.hours.close }}" data-hours-tz="{{ machine.hours.timezone }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div>
                <strong>{{ t.ui.location_page.hours }}</strong>
                <p>
                  {{ machine.hours.display }}
                  <span class="location-hours location-hours-inline">
                    <span class="location-status-dot"></span>
                    <span class="location-status-text"></span>
                  </span>
                </p>
              </div>
            </div>
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              <div>
                <strong>{{ t.ui.location_page.style }}</strong>
                <p>{{ machine.style }}</p>
              </div>
            </div>
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <div>
                <strong>{{ t.ui.location_page.website }}</strong>
                <p><a href="{{ machine.websiteUrl }}" target="_blank" rel="noopener">{{ machine.websiteName }}</a></p>
              </div>
            </div>
          </div>
        </div>
        <div class="location-about-description">
          {% for paragraph in machine.description %}
          <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  {# ======== Gallery ======== #}
  {% if machine.photos and machine.photos.length %}
  <section class="location-gallery">
    <div class="container">
      <h2>{{ t.ui.location_page.gallery_heading }} {{ machine.name }}</h2>
      <div class="location-gallery-grid">
        {% for photo in machine.photos %}
        {% if photo.src %}
        <figure class="location-gallery-card">
          <img
            src="{{ photo.src | url }}"
            alt="{{ photo.alt or (machine.name + ' photo') }}"
            loading="lazy"
            decoding="async"
            width="{{ photo.width or 1600 }}"
            height="{{ photo.height or 1067 }}"
          >
          {% if photo.caption %}
          <figcaption>{{ photo.caption }}</figcaption>
          {% endif %}
        </figure>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ======== CTA ======== #}
  <section class="location-cta">
    <div class="container">
      <div class="location-cta-card">
        <h2>{{ machine.name }}</h2>
        <p>{{ t.ui.location_page.cta_sub }}</p>
        <div class="location-cta-actions">
          <a href="{{ machine.mapsUrl }}" target="_blank" rel="noopener" class="btn btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {{ t.ui.location_page.cta_maps }}
          </a>
          <a href="{{ localeHome }}#locations" class="btn btn-secondary">
            {{ t.ui.location_page.cta_all_locations }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="location-cta-contact">
          <span>{{ t.ui.location_page.questions }}</span>
          <a href="{{ site.contact.telegram.url }}" target="_blank" rel="noopener">{{ t.ui.contact.telegram }}</a>
          <a href="mailto:{{ site.contact.email }}">{{ t.ui.contact.email }}</a>
        </div>
      </div>
    </div>
  </section>
</div>

{# ======== Footer ======== #}
{% include "footer.njk" %}

{# Pass UI labels to JS #}
<script>
  window.BTM_UI = { open: "{{ t.ui.js.open }}", closed: "{{ t.ui.js.closed }}" };
</script>
