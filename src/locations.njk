---
layout: base.njk
pagination:
  data: collections.btmLocationsAll
  size: 1
  alias: item
permalink: "{{ item.localePrefix }}locations/{{ item.machine.slug }}/index.html"
eleventyComputed:
  locale: "{{ item.locale }}"
  pageTitle: "{{ item.machine.name }} BTM — {{ item.machine.district }} — {{ site.name }}"
  pageDescription: "{{ i18n[item.locale].ui.location_page.cta_sub }} {{ item.machine.name }} — {{ item.machine.district }}. {{ item.machine.hours.display }}"
  canonicalPath: "{{ item.localePrefix }}locations/{{ item.machine.slug }}/"
  basePath: "locations/{{ item.machine.slug }}/"
  pageImage: "{{ item.machine.photos[0].src if item.machine.photos and item.machine.photos.length else '/images/bitcoinvn-logo-dark.png' }}"
---
{% set machine = item.machine %}
{% set t = i18n[item.locale] %}
{% set localeHome = "/" + item.localePrefix %}

{# ======== Navigation ======== #}
<nav class="nav scrolled" id="nav">
  <div class="nav-container">
    <a href="{{ localeHome }}" class="nav-logo">
      <img src="{{ '/images/bitcoinvn-logo-dark.png' | url }}" alt="BitcoinVN" class="logo-img">
      <span class="logo-btm">BTM</span>
    </a>
    <div class="nav-links" id="navLinks">
      <a href="{{ localeHome }}#locations">{{ t.ui.nav.all_locations }}</a>
      <a href="{{ localeHome }}#how-it-works">{{ t.ui.nav.how_it_works }}</a>
      <a href="{{ localeHome }}#faq">{{ t.ui.nav.faq }}</a>
      <a href="/{{ item.localePrefix }}host/">{{ t.ui.host.nav_label }}</a>
    </div>
    {% include "locale-switcher.njk" %}
    <button class="nav-toggle" id="navToggle" aria-label="{{ t.ui.nav.toggle_menu }}">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="location-detail">
  {% if machine.photos and machine.photos.length %}
  <img class="location-detail__hero-bg" src="{{ machine.photos[0].src | url }}" alt="" aria-hidden="true">
  {% endif %}
  {# ======== Breadcrumb ======== #}
  <div class="container">
    <nav class="breadcrumb">
      <a href="{{ localeHome }}">{{ t.ui.location_page.breadcrumb_home }}</a>
      <span class="bc-sep" aria-hidden="true">&rsaquo;</span>
      <a href="{{ localeHome }}#locations">{{ t.ui.location_page.breadcrumb_locations }}</a>
      <span class="bc-sep" aria-hidden="true">&rsaquo;</span>
      <a href="{{ (localeHome + machine.regionSlug + '/') | url }}">{{ machine.regionName }}</a>
      <span class="bc-sep" aria-hidden="true">&rsaquo;</span>
      <span class="bc-current">{{ machine.name }}</span>
    </nav>
  </div>

  {# ======== Hero ======== #}
  <section class="location-hero">
    <div class="container">
      <span class="location-region-badge">{{ machine.regionName }}</span>
      <h1>{{ machine.name }}</h1>
      <p class="location-hero-district">{{ machine.district }}</p>
    </div>
  </section>

  {# ======== Map + Info Card ======== #}
  <section class="location-map-section">
    <div class="container">
      <div class="location-map-card">
        <aside class="location-map-card__info">
          <div class="info-block" data-hours-days="{{ machine.hours.days | join(',') }}" data-hours-open="{{ machine.hours.open }}" data-hours-close="{{ machine.hours.close }}" data-hours-tz="{{ machine.hours.timezone }}">
            <h3>{{ t.ui.location_page.opening_hours }}</h3>
            <div class="info-list">
              <span class="info-line">
                <span class="location-status-dot"></span>
                <span class="location-status-text"></span>
              </span>
              <span class="info-line">{{ machine.hours.open }} &mdash; {{ machine.hours.close }}</span>
            </div>
          </div>
          <div class="info-block">
            <h3>{{ t.ui.location_page.cryptocurrencies }}</h3>
            <div class="info-list info-list--pills">
              {% for asset in site.supported_assets %}
              <span class="info-pill{% if not asset.buy and not asset.sell %} info-pill--disabled{% endif %}">
                <span>{{ asset.ticker }}</span>
                <span class="info-pill__ops">
                  {% if asset.buy %}<span aria-label="{{ t.ui.location_page.action_buy }}">&#x2191;</span>{% endif %}
                  {% if asset.sell %}<span aria-label="{{ t.ui.location_page.action_sell }}">&#x2193;</span>{% endif %}
                </span>
              </span>
              {% endfor %}
            </div>
          </div>
          <div class="info-block">
            <h3>{{ t.ui.location_page.directions }}</h3>
            <div class="directions-list">
              <a class="directions-btn" href="{{ machine.mapsUrl }}" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{{ t.ui.location_page.directions_google }}</span>
              </a>
              <a class="directions-btn" href="https://maps.apple.com/?daddr={{ machine.lat }},{{ machine.lng }}&amp;dirflg=d" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                <span>{{ t.ui.location_page.directions_apple }}</span>
              </a>
              <a class="directions-btn" href="https://www.openstreetmap.org/directions?to={{ machine.lat }}%2C{{ machine.lng }}" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                <span>{{ t.ui.location_page.directions_osm }}</span>
              </a>
            </div>
          </div>
        </aside>
        <div class="location-map-card__map" id="location-detail-map" data-lat="{{ machine.lat }}" data-lng="{{ machine.lng }}" data-name="{{ machine.name }}" data-district="{{ machine.district }}">
        </div>
      </div>
    </div>
  </section>

  {# ======== About ======== #}
  <section class="location-about">
    <div class="container">
      <h2 class="location-about-heading">{{ t.ui.location_page.about }}</h2>
      <div class="location-about-grid">
        <div class="location-about-details">
          <div class="location-detail-list">
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <strong>{{ t.ui.location_page.address }}</strong>
                <p>{{ machine.address }}</p>
              </div>
            </div>
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div>
                <strong>{{ t.ui.location_page.phone }}</strong>
                <p>{{ machine.phone }}</p>
              </div>
            </div>
            <div class="location-detail-item" data-hours-days="{{ machine.hours.days | join(',') }}" data-hours-open="{{ machine.hours.open }}" data-hours-close="{{ machine.hours.close }}" data-hours-tz="{{ machine.hours.timezone }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div>
                <strong>{{ t.ui.location_page.hours }}</strong>
                <p>
                  {{ machine.hours.display }}
                  <span class="location-hours location-hours-inline">
                    <span class="location-status-dot"></span>
                    <span class="location-status-text"></span>
                  </span>
                </p>
              </div>
            </div>
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              <div>
                <strong>{{ t.ui.location_page.style }}</strong>
                <p>{{ machine.style }}</p>
              </div>
            </div>
            <div class="location-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <div>
                <strong>{{ t.ui.location_page.website }}</strong>
                <p><a href="{{ machine.websiteUrl }}" target="_blank" rel="noopener">{{ machine.websiteName }}</a></p>
              </div>
            </div>
          </div>
        </div>
        <div class="location-about-description">
          {% for paragraph in machine.description %}
          <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  {# ======== Gallery ======== #}
  {% if machine.photos and machine.photos.length %}
  <section class="location-gallery">
    <div class="container">
      <h2>{{ t.ui.location_page.gallery_heading }} {{ machine.name }}</h2>
      <div class="location-gallery-grid">
        {% for photo in machine.photos %}
        {% if photo.src %}
        <figure class="location-gallery-card">
          <img
            src="{{ photo.src | url }}"
            alt="{{ photo.alt or (machine.name + ' photo') }}"
            loading="lazy"
            decoding="async"
            width="{{ photo.width or 1600 }}"
            height="{{ photo.height or 1067 }}"
          >
          {% if photo.caption %}
          <figcaption>{{ photo.caption }}</figcaption>
          {% endif %}
        </figure>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

</div>

{# ======== Footer ======== #}
{% include "footer.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "FinancialService"],
  "@id": {{ (item.localePrefix + "locations/" + machine.slug + "/#btm") | absoluteUrl(site.url) | jsonify | safe }},
  "name": {{ (machine.name + " BitcoinVN BTM") | jsonify | safe }},
  "description": {{ pageDescription | jsonify | safe }},
  "url": {{ (item.localePrefix + "locations/" + machine.slug + "/") | absoluteUrl(site.url) | jsonify | safe }},
  "telephone": {{ machine.phone | jsonify | safe }},
  "priceRange": "VND",
  "currenciesAccepted": "VND, BTC, USDT, USDC",
  "paymentAccepted": "Cash",
  "image": [
    {% for photo in machine.photos %}
    {{ photo.src | absoluteUrl(site.url) | jsonify | safe }}{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ machine.address | jsonify | safe }},
    "addressLocality": {{ machine.regionName | jsonify | safe }},
    "addressCountry": "VN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ machine.lat }},
    "longitude": {{ machine.lng }}
  },
  "hasMap": {{ machine.mapsUrl | jsonify | safe }},
  "openingHours": {{ ("Mo-Su " + machine.hours.open + "-" + machine.hours.close) | jsonify | safe }},
  "areaServed": {
    "@type": "City",
    "name": {{ machine.regionName | jsonify | safe }}
  },
  "parentOrganization": {
    "@type": "Organization",
    "name": "BitcoinVN",
    "url": {{ site.exchangeUrl | jsonify | safe }}
  }
}
</script>

{# Pass UI labels to JS #}
<script>
  window.BTM_UI = { open: "{{ t.ui.js.open }}", closed: "{{ t.ui.js.closed }}" };
</script>
