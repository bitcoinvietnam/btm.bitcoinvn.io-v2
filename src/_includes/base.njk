<!DOCTYPE html>
<html lang="{{ locale | default('en') }}">
<head>
  {% set metaTitle = (pageTitle | safe) if pageTitle else (site.name + " — Buy & Sell Bitcoin for Cash in Vietnam") %}
  {% set metaDescription = (pageDescription | safe) if pageDescription else site.description %}
  {% set canonicalUrl = (canonicalPath if canonicalPath is defined else "") | absoluteUrl(site.url) %}
  {% set shareImage = (pageImage if pageImage is defined else "/images/bitcoinvn-logo-dark.png") | absoluteUrl(site.url) %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="{{ shareImage }}">
  <link rel="icon" type="image/png" href="{{ '/images/bitcoinvn-icon.png' | url }}">
  {% for loc in locales %}
  <link rel="alternate" hreflang="{{ loc.code }}" href="{{ (loc.pathPrefix + basePath) | absoluteUrl(site.url) }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ basePath | absoluteUrl(site.url) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Noto+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  {% if locale == 'ko' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">{% endif %}
  {% if locale == 'ja' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">{% endif %}
  {% if locale == 'zh' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">{% endif %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
  {% if isProduction %}
  <script defer data-domain="bitcoinvn.io/btm" src="https://plausible.bitcoinvn.io/js/script.js"></script>
  {% endif %}
</head>
<body>
  {{ content | safe }}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="{{ '/js/main.js' | url }}"></script>
  <script src="{{ '/js/plausible-events.js' | url }}"></script>
</body>
</html>
